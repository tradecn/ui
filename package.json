{
  "name": "tradecn-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p playground/tsconfig.app.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "validate": "bun scripts/validate-registry.ts",
    "tokens": "bun scripts/sync-tokens.ts",
    "tokens:check": "bun scripts/sync-tokens.ts --check",
    "lock:builtins": "bun scripts/builtins-lock.ts",
    "lock:builtins:check": "bun scripts/builtins-lock.ts --check",
    "registry:validate": "shadcn registry validate ./registry.json",
    "registry:build": "shadcn build -o public/r",
    "check": "bun run lint && bun run typecheck && bun run test && bun run validate && bun run tokens:check && bun run registry:validate && bun run registry:build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@shikijs/core": "4.4.3",
    "@shikijs/engine-oniguruma": "4.4.3",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "cn": "^0.3.0",
    "dockview-react": "^8.3.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "marked": "18.0.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "4.21.0",
    "ts-morph": "^28.0.0",
    "typescript": "~6",
    "typescript-eslint": "^8.70.0",
    "uplot": "^1.6.32",
    "vitest": "^5.0.1"
  }
}
